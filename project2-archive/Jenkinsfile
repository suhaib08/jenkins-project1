pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main', url: 'https://github.com/suhaib08/jenkins-project1.git'
            }
        }

        stage('Generate Report') {
            steps {
                dir('project2-archive') {
                    bat 'python app.py'
                }
            }
        }

        stage('Archive Report') {
            steps {
                archiveArtifacts artifacts: 'project2-archive/report.txt', fingerprint: true
            }
        }
    }
}
